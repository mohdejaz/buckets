# Never bake secrets or local state into the image
.env
.envrc
buckets.db
buckets.db-journal
# Hand-made backups taken before a migration. .gitignore already keeps these
# out of the repo; without the same rule here, COPY . . would bake a full copy
# of the real database into a published image.
buckets.db.bak-*

venv/
__pycache__/
*.pyc

.git/
.gitignore
.github/
.claude/
README.md
docs/
run.sh
run.bat
docker-compose.yml

# Raw screen recordings. The tour is optional — the app leaves every control
# that opens it out of the page when media/ has no recording — so an unpruned
# original must never be baked into an image by COPY . .
*.mov
